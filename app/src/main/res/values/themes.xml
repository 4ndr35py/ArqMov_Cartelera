<resources>
    <style name="Theme.Cartelera" parent="Theme.Material3.Light.NoActionBar">
        <!-- Botones: fondo negro con texto lima, como el boton de la pagina del cine. -->
        <item name="colorPrimary">@color/negro</item>
        <item name="colorOnPrimary">@color/lima</item>
        <item name="colorPrimaryContainer">@color/lima_claro</item>
        <item name="colorOnPrimaryContainer">@color/negro</item>
        <item name="colorSecondary">@color/lima</item>
        <item name="colorOnSecondary">@color/negro</item>
        <item name="android:colorBackground">@color/gris_fondo</item>
        <item name="colorSurface">@color/papel</item>
        <item name="colorOnSurface">@color/grafito</item>
        <item name="colorOnSurfaceVariant">@color/gris</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Tipografia de la marca: Montserrat en todos los estilos de texto. -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Cartelera.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Cartelera.TitleMedium</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Cartelera.HeadlineMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Cartelera.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Cartelera.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Cartelera.LabelLarge</item>
    </style>

    <!-- Barra superior: blanca con una linea lima abajo (drawable fondo_barra) y titulo en mayusculas. -->
    <style name="Widget.Cartelera.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">@drawable/fondo_barra</item>
        <item name="titleTextAppearance">@style/TextAppearance.Cartelera.Marca</item>
        <item name="titleTextColor">@color/negro</item>
        <item name="navigationIconTint">@color/negro</item>
    </style>

    <style name="TextAppearance.Cartelera.Marca" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.Cartelera.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Cartelera.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Cartelera.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Cartelera.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/montserrat</item>
    </style>

    <style name="TextAppearance.Cartelera.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/montserrat</item>
    </style>

    <style name="TextAppearance.Cartelera.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
