<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necesario: Firebase, TMDB y los afiches usan la red. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+: permiso para mostrar el recordatorio. La app lo pide
         recien cuando el usuario marca una funcion, no al abrirse. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Analytics agrega este permiso por merge. La app no usa publicidad,
         asi que lo quitamos (principio de minimo privilegio). -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Visibilidad de paquetes: necesitamos consultar
         si hay un navegador para abrir la pagina de venta de entradas. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".CarteleraApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cartelera">

        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- FCM: canal e icono para los mensajes que llegan con la app cerrada. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="avisos" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacion" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/negro" />

        <!-- Desde el TP7 la cartelera es la pantalla de inicio (se ve sin cuenta). -->
        <activity
            android:name=".ui.cartelera.CarteleraActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.detalle.DetalleActivity"
            android:exported="false"
            android:parentActivityName=".ui.cartelera.CarteleraActivity" />

        <!-- TP7: una pelicula con sus fotos, su trailer y sus funciones. -->
        <activity
            android:name=".ui.pelicula.PeliculaActivity"
            android:exported="false"
            android:parentActivityName=".ui.cartelera.CarteleraActivity" />

        <!-- TP4: donaciones in-app (Google Play Billing). -->
        <activity
            android:name=".ui.donacion.DonacionActivity"
            android:exported="false"
            android:parentActivityName=".ui.cartelera.CarteleraActivity" />

        <!-- TP6: avisos por tema (topics de FCM) y lista "Quiero verla". -->
        <activity
            android:name=".ui.avisos.AvisosActivity"
            android:exported="false"
            android:parentActivityName=".ui.cartelera.CarteleraActivity" />

        <activity
            android:name=".ui.quierover.QuieroVerActivity"
            android:exported="false"
            android:parentActivityName=".ui.cartelera.CarteleraActivity" />

        <!-- Barra inferior: pestanas Entradas y Perfil. -->
        <activity
            android:name=".ui.entradas.EntradasActivity"
            android:exported="false"
            android:parentActivityName=".ui.cartelera.CarteleraActivity" />

        <activity
            android:name=".ui.perfil.PerfilActivity"
            android:exported="false"
            android:parentActivityName=".ui.cartelera.CarteleraActivity" />

        <!-- Servicio de avisos: recibe los mensajes de FCM y los tokens nuevos. -->
        <service
            android:name=".data.avisos.AvisosService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
