<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/negro"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAfiche"
            android:layout_width="96dp"
            android:layout_height="144dp"
            android:background="@color/gris_oscuro"
            android:contentDescription="@string/cd_afiche"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CarteleraPosterOverlay" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/lima" />

            <TextView
                android:id="@+id/tvFechas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/blanco" />

            <TextView
                android:id="@+id/tvDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/gris_claro" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivInteres"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/fondo_circulo"
            android:contentDescription="@string/cd_interes"
            android:padding="5dp"
            android:src="@drawable/ic_estrella_llena"
            android:visibility="gone"
            app:tint="@color/lima" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
