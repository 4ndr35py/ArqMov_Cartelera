rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cartelera: la lee cualquier sesion, tambien la anonima (TP7). Nadie la
    // escribe desde la app; la carga el cine (consola o script de carga).
    match /funciones/{funcionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Documento del usuario: token de FCM (TP7) y preferencias de avisos por
    // tema (TP6): temas.{tema} = true|false. Ningun otro campo.
    match /usuarios/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokenFcm', 'actualizado', 'temas'])
        && (!('temas' in request.resource.data) || request.resource.data.temas is map);
    }

    // Intereses: cada usuario lee y escribe solo los suyos.
    match /usuarios/{uid}/intereses/{funcionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
