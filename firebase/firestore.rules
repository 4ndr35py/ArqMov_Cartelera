rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cartelera: la lee cualquier sesion, tambien la anonima (TP7). Nadie la
    // escribe desde la app; la carga el cine (consola o script de carga).
    match /funciones/{funcionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Documento del usuario: token de FCM (TP7) y preferencias de avisos por
    // tema (TP6): temas.{tema} = true|false. Ningun otro campo.
    match /usuarios/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokenFcm', 'actualizado', 'temas'])
        && (!('temas' in request.resource.data) || request.resource.data.temas is map);
    }

    // Comentarios (TP6): se leen solo los aprobados por el cine; cualquier sesion
    // puede escribir uno nuevo, oculto (aprobado = false). La app no aprueba,
    // edita ni borra: eso lo hace el cine desde la consola.
    match /comentarios/{comentarioId} {
      allow read: if resource.data.aprobado == true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['clave', 'texto', 'uid', 'fecha', 'aprobado'])
        && request.resource.data.clave is string
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 500
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.fecha == request.time
        && request.resource.data.aprobado == false;
      allow update, delete: if false;
    }

    // Intereses: cada usuario lee y escribe solo los suyos.
    match /usuarios/{uid}/intereses/{funcionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
