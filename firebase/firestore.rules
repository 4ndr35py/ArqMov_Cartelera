rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cartelera: cualquier usuario autenticado la lee. Nadie la escribe
    // desde la app; la carga el cine (consola o script de carga).
    match /funciones/{funcionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Intereses: cada usuario lee y escribe solo los suyos.
    match /usuarios/{uid}/intereses/{funcionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
