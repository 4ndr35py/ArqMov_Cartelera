<?xml version="1.0" encoding="utf-8"?>
<!-- Barra superior: fondo negro y una linea lima abajo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/negro" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lima" />
        </shape>
    </item>
</layer-list>
