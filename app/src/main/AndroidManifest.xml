<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necesario: Firebase Auth, Firestore y Analytics usan la red. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Analytics agrega este permiso por merge. El MVP no usa publicidad,
         asi que lo quitamos (principio de minimo privilegio). -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Visibilidad de paquetes: necesitamos consultar
         si hay un navegador para abrir la pagina de venta de entradas. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".CarteleraApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cartelera">

        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.cartelera.CarteleraActivity"
            android:exported="false" />

        <activity
            android:name=".ui.detalle.DetalleActivity"
            android:exported="false"
            android:parentActivityName=".ui.cartelera.CarteleraActivity" />
    </application>
</manifest>
