<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal: la barra superior, la pestana actual y una barra inferior flotante tipo vidrio. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Cartelera.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_cartelera"
            app:title="@string/cartelera_titulo"
            app:titleTextColor="@color/blanco" />

        <!-- Cada pestana es un fragmento: la barra inferior no desaparece al cambiar de pestana. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/contenido"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Desvanecido detras de la barra: el contenido se apaga al llegar abajo. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_isla" />

    <!-- Barra flotante solo con iconos: flota centrada sobre el contenido. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navegacion"
        android:layout_width="300dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/fondo_isla"
        app:elevation="8dp"
        app:itemIconTint="@color/nav_icono"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/menu_navegacion" />
</FrameLayout>
